    {
      "text": "排骨冷水下锅，煮开后再煮3分钟，捞出洗净。",
      "method": "blanch",
      "heat": "high",
      "timer": 180
    },
    {
      "text": "汤锅加1500毫升水、姜、排骨和莲藕，大火煮开。",
      "method": "stew",
      "heat": "high"
