 "steps": [
  {
   "text": "花甲泡淡盐水吐沙，搓洗干净；青椒和辣椒切块，蒜和豆豉剁碎。",
   "method": "cut",
   "heat": "off"
  },
  {
   "text": "烧开水，下花甲，刚张口就捞出，没开口的挑出。",
   "method": "blanch",
   "heat": "high",
   "timer": 60,
   "tip": "开口就捞，肉才嫩"
  },
  {
   "text": "热锅放油，炒香蒜末和豆豉，下青椒和辣椒。",
   "method": "stir_fry",
   "heat": "mid",
   "timer": 60
  },
  {
   "text": "倒入花甲，加料酒和生抽，大火翻炒30秒出锅。",
   "method": "stir_fry",
   "heat": "high",
   "timer": 30
  }
