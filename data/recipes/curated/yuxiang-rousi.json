  "steps": [
    {
      "text": "木耳提前泡发；肉、木耳、胡萝卜、青椒都切丝，姜蒜切末。",
      "method": "cut",
      "heat": "off"
    },
    {
      "text": "肉丝加少许生抽、1小勺淀粉和油抓匀，腌10分钟。",
      "method": "marinate",
      "heat": "off",
      "timer": 600
    },
    {
      "text": "醋、糖、生抽、1小勺淀粉加3大勺水，调成鱼香汁。",
      "method": "mix",
      "heat": "off",
      "tip": "糖醋一比一"
    },
    {
      "text": "热锅放油，下肉丝快速划散，变白就盛出。",
      "method": "stir_fry",
      "heat": "high",
      "timer": 60
    },
    {
      "text": "炒香姜蒜和豆瓣酱，下胡萝卜、木耳、青椒炒1分钟。",
      "method": "stir_fry",
      "heat": "high",
      "timer": 60
    },
    {
      "text": "倒回肉丝和鱼香汁，大火翻匀到汁变亮，出锅。",
      "method": "stir_fry",
      "heat": "high",
      "timer": 30
    }
