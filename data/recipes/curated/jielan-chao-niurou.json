 "steps": [
  {
   "text": "牛肉逆着纹路切薄片，加生抽、淀粉和1小勺油腌10分钟。",
   "method": "marinate",
   "heat": "off",
   "timer": 600
  },
  {
   "text": "芥兰削去粗梗的老皮，斜切成段；蒜和姜切片。",
   "method": "cut",
   "heat": "off"
  },
  {
   "text": "烧开水，加少许盐和油，芥兰焯1分钟，捞出沥干。",
   "method": "blanch",
   "heat": "high",
   "timer": 60
  },
  {
   "text": "热锅放油，大火滑炒牛肉到七成变色，盛出。",
   "method": "stir_fry",
   "heat": "high",
   "timer": 60,
   "tip": "火要大，动作要快"
  },
  {
   "text": "炒香蒜姜，下芥兰和牛肉，加蚝油大火翻匀出锅。",
   "method": "stir_fry",
   "heat": "high",
