 "steps": [
  {
   "text": "鲈鱼处理干净并擦干，两面各划2刀，抹上1大勺料酒。",
   "method": "cut",
   "heat": "off"
  },
  {
   "text": "姜切片垫在盘底，鱼身上也放几片姜和几段葱。",
   "method": "cut",
   "heat": "off"
  },
  {
   "text": "水烧开后放入鱼，大火蒸 8 分钟。",
   "method": "steam",
   "heat": "high",
   "timer": 480,
   "tip": "每多 100 克加 1 分钟"
  },
  {
   "text": "测最厚鱼肉达63℃再关火焖2分钟；未达温继续蒸。",
   "method": "steam",
   "heat": "off",
   "timer": 120,
   "tip": "测温探针避开骨头"
  },
  {
   "text": "铺上新切的葱丝和姜丝，淋上蒸鱼豉油。",
   "method": "mix",
   "heat": "off"
  },
  {
   "text": "将2大勺油加热至流动变快、尚未冒烟，关火后浇在葱姜上。",
   "method": "fry",
   "heat": "high",
   "tip": "擦干鱼盘外侧水滴"
  }
