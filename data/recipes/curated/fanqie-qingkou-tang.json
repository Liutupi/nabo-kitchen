 "steps": [
  {
   "text": "番茄洗净切块，姜切片；另用器具刷洗鲜活贝壳。",
   "method": "cut",
   "heat": "off"
  },
  {
   "text": "破壳、敲壳仍不闭合的活贝丢弃；处理后洗手洗具。",
   "method": "cut",
   "heat": "off"
  },
  {
   "text": "锅中放700毫升水和姜煮开，加入番茄煮熟。",
   "method": "boil",
   "heat": "mid",
   "timer": 360
  },
  {
   "text": "放入贝类煮至开口；未开口的丢弃。",
   "method": "boil",
   "heat": "mid"
  },
  {
   "text": "开口后的贝类继续煮3分钟，至贝肉熟透。",
   "method": "boil",
   "heat": "mid",
   "timer": 180
  },
  {
   "text": "加盐调味盛出。",
