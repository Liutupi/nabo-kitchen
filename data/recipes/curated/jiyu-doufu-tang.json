  {
   "text": "加入1200毫升热水、姜葱和料酒，大火煮开。",
   "method": "boil",
   "heat": "high"
  },
  {
   "text": "转中火煮15分钟。",
   "method": "stew",
   "heat": "mid",
   "timer": 900
