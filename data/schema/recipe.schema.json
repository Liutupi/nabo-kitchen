{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "nabo-kitchen/recipe.schema.json",
 "title": "NABO 深夜厨房菜谱",
 "type": "object",
 "required": [
  "id",
  "name",
  "course",
  "minutes",
  "difficulty",
  "servings",
  "ingredients",
  "seasonings",
  "steps",
  "dish",
  "source",
  "version"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
   "maxLength": 40,
   "description": "永久 ID，拼音或英文，发布后不改"
  },
  "name": {
   "type": "string",
   "maxLength": 10
  },
  "aliases": {
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 10
   },
   "maxItems": 4
  },
  "course": {
   "type": "array",
   "items": {
    "enum": [
     "meat",
     "veg",
     "soup",
     "staple"
    ]
   },
   "minItems": 1,
   "maxItems": 2,
   "uniqueItems": true
  },
  "cuisine": {
   "enum": [
    "家常",
    "粤",
    "川",
    "湘",
    "鲁",
    "江浙",
    "东北",
    "西北",
    "其他"
   ]
  },
  "tags": {
   "type": "array",
   "items": {
    "enum": [
     "快手",
     "下饭",
     "少油",
     "清淡",
     "微辣",
     "辣",
     "下酒",
     "夜宵",
     "宴客",
     "一锅出",
     "免开火",
     "适合新手",
     "想试试"
    ]
   },
   "maxItems": 4,
   "uniqueItems": true
  },
  "minutes": {
   "type": "integer",
   "minimum": 3,
   "maximum": 240
  },
  "difficulty": {
   "type": "integer",
   "minimum": 1,
   "maximum": 3
  },
  "servings": {
   "type": "integer",
   "minimum": 1,
   "maximum": 6
  },
  "season": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 1,
    "maximum": 12
   },
   "uniqueItems": true
  },
  "ingredients": {
   "type": "array",
   "minItems": 1,
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": [
     "id",
     "qty",
     "unit"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "description": "必须存在于 data/ingredients.json"
     },
     "qty": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "unit": {
      "enum": [
       "克",
       "个",
       "根",
       "瓣",
       "块",
       "片",
       "条",
       "只",
       "把",
       "颗",
       "朵",
       "段",
       "斤",
       "适量"
      ]
     },
     "main": {
      "type": "boolean",
      "default": false
     },
     "note": {
      "type": "string",
      "maxLength": 10
     }
    }
   }
  },
  "seasonings": {
   "type": "array",
   "maxItems": 12,
   "items": {
    "type": "object",
    "required": [
     "id",
     "qty"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "description": "必须存在于 data/seasonings.json"
     },
     "qty": {
      "type": "string",
      "maxLength": 8
     }
    }
   }
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "maxItems": 12,
   "items": {
    "type": "object",
    "required": [
     "text",
     "method",
     "heat"
    ],
    "additionalProperties": false,
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 48
     },
     "method": {
      "enum": [
       "stir_fry",
       "steam",
       "boil",
       "braise",
       "fry",
       "mix",
       "cut",
       "marinate",
       "blanch",
       "stew"
      ]
     },
     "heat": {
      "enum": [
       "high",
       "mid",
       "low",
       "off"
      ]
     },
     "timer": {
      "type": "integer",
      "minimum": 5,
      "maximum": 14400,
      "description": "秒"
     },
     "tip": {
      "type": "string",
      "maxLength": 16
     }
    }
   }
  },
  "dish": {
   "type": "object",
   "required": [
    "vessel",
    "sauce",
    "layers"
   ],
   "additionalProperties": false,
   "properties": {
    "vessel": {
     "enum": [
      "plate",
      "oval",
      "bowl",
      "claypot",
      "steamer",
      "deep"
     ]
    },
    "sauce": {
     "type": [
      "string",
      "null"
     ],
     "description": "sauce ID，不含器皿组后缀；打包时自动选择 __plate/__bowl/__claypot"
    },
    "layers": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z_]+__[a-z_]+$"
     },
     "minItems": 1,
     "maxItems": 4
    },
    "garnish": {
     "type": "array",
     "items": {
      "enum": [
       "scallion",
       "chili_ring",
       "sesame",
       "cilantro",
       "ginger_shred",
       "garlic",
       "shine"
      ]
     },
     "maxItems": 3
    },
    "hero": {
     "type": "boolean",
     "default": false
    }
   }
  },
  "source": {
   "enum": [
    "curated",
    "user",
    "ai"
   ]
  },
  "author": {
   "type": "string",
   "maxLength": 20
  },
  "version": {
   "type": "integer",
   "minimum": 1
  }
 }
}